# 知选部署配置。复制为 .env 后按需修改：cp .env.example .env
# .env 含密钥，不要提交到仓库。

# ===== A. 部署基础 =====
# 镜像标签（本地构建时作为 zhixuan-app 的 tag）
ZHIXUAN_VERSION=latest
# 浏览器访问端口（nginx）
FRONTEND_PORT=80
# 应用端口，只绑定在本机 127.0.0.1，便于排查
APP_PORT=8080

# ===== B. 数据存储 =====
# 默认使用容器内 SQLite（/data/app.db，保存在 app-data 卷）。
# 想改用 Supabase，填写以下两项（service role key 只放服务端）：
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ===== C. Agent =====
# 导购 Agent 的语言服务密钥。不填时改写、讲解和商品问答使用内置文案，选品和预算判定不受影响。
AGENT_API_KEY=
# AGENT_MODEL=

# ===== D. 安全与业务 =====
# 通过 HTTPS 对外提供服务时设为 1（会话 Cookie 加 Secure）
COOKIE_SECURE=0
# 报价有效期（小时），超过后只作参考、不能确认预算
PRICE_TTL_HOURS=336
